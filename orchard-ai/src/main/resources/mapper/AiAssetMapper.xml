<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.orchardai.mapper.AiAssetMapper">

    <!-- 联查作者昵称/头像，只查列表所需字段 -->
    <sql id="baseAuthorSql">
        SELECT a.id, a.user_id, a.type, a.prompt, a.params, a.url, a.tags, a.like_count, a.create_time,
               u.nickname AS author_name, u.avatar AS author_avatar
        FROM t_ai_asset a
        LEFT JOIN t_user u ON a.user_id = u.id
        WHERE a.deleted = 0
    </sql>

    <!-- 分页联查（tag 入参需为 JSON 精确值，如 "人像"） -->
    <select id="selectPageWithAuthor" resultType="com.example.orchardai.dto.AiAssetRow">
        <include refid="baseAuthorSql"/>
        <if test="type != null and type != ''">
            AND a.type = #{type}
        </if>
        <if test="keyword != null and keyword != ''">
            AND a.prompt LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="tag != null and tag != ''">
            AND a.tags LIKE CONCAT('%', #{tag}, '%')
        </if>
        ORDER BY a.create_time DESC
    </select>

    <!-- 单条联查 -->
    <select id="selectDetailWithAuthor" resultType="com.example.orchardai.dto.AiAssetRow">
        <include refid="baseAuthorSql"/>
        AND a.id = #{id}
    </select>

</mapper>
